{
  "name": "duizhan-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-assets.mjs",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "d1:apply": "wrangler d1 execute duizhan-db --file ./schema.sql --remote",
    "d1:apply:local": "wrangler d1 execute duizhan-db --file ./schema.sql --local"
  },
  "dependencies": {
    "hono": "^4.8.3"
  },
  "devDependencies": {
    "wrangler": "^4.11.1"
  }
}
